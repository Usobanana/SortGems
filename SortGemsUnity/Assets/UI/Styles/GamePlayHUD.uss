/* ===== HUD Chrome ===== */
.hud-top {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    padding: var(--sp-sm) var(--sp-md);
    background-color: var(--color-bar-bg);
}

.hud-stage-name {
    font-size: var(--fs-body-lg);
    color: var(--color-text);
    -unity-font-style: bold;
    margin: 0 var(--sp-md);
}

/* ===== Timer ===== */
.timer-group {
    position: absolute;
    top: 480px;
    left: 0;
    right: 0;
    align-items: center;
    padding: var(--sp-sm) 0;
}

.timer-bar-bg {
    width: 80%;
    height: 20px;
    background-color: var(--color-bar-track);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: var(--sp-xs);
}

.timer-bar-fill {
    height: 100%;
    width: 100%;
    background-color: var(--color-success);
    border-radius: 10px;
    transition-duration: 0.3s;
}

.timer-text {
    font-size: var(--fs-h3);
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ===== Bottom Bar ===== */
.hud-bottom {
    flex-direction: row;
    justify-content: center;
    align-self: stretch;
    padding: var(--sp-sm) var(--sp-md);
    background-color: var(--color-bar-bg);
}

.hud-bottom > .btn {
    margin: 0 var(--sp-sm);
}

/* ===== Result Overlays ===== */
.result-panel {
    min-width: 520px;
    padding: var(--sp-2xl) var(--sp-2xl);
}

.result-title {
    font-size: var(--fs-display);
    -unity-font-style: bold;
    margin-bottom: var(--sp-xl);
    -unity-text-align: middle-center;
}

.result-title-cleared {
    color: var(--color-accent);
}

.result-title-failed {
    color: var(--color-danger);
}

.result-buttons {
    align-items: stretch;
    align-self: stretch;
}

.result-buttons > .btn {
    margin: var(--sp-sm) 0;
}

.result-buttons > .btn:first-child {
    font-size: var(--fs-btn-lg);
    min-height: 64px;
}

/* ===== Unlock Dialog ===== */
.unlock-panel {
    min-width: 520px;
    padding: var(--sp-2xl) var(--sp-2xl);
    align-items: center;
}

.unlock-title {
    font-size: var(--fs-h1);
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: var(--sp-md);
    -unity-text-align: middle-center;
}

.unlock-desc {
    font-size: var(--fs-body);
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    margin-bottom: var(--sp-lg);
    white-space: normal;
}

.unlock-buttons {
    align-items: stretch;
    align-self: stretch;
}

.unlock-buttons > .btn {
    margin: var(--sp-sm) 0;
}

.unlock-buttons > .btn:first-child {
    font-size: var(--fs-btn-lg);
    min-height: 64px;
}
