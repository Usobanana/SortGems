.hud-top {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    padding: 12px 16px;
    background-color: rgba(0, 0, 0, 0.5);
}

.btn-icon {
    font-size: 24px;
    padding: 10px 14px;
    min-width: 48px;
}

.hud-stage-name {
    font-size: 24px;
    color: var(--color-text);
    -unity-font-style: bold;
    margin: 0 12px;
}

.timer-group {
    align-items: center;
    align-self: stretch;
    padding: 8px 0;
}

.timer-bar-bg {
    width: 600px;
    height: 20px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 4px;
}

.timer-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(50, 215, 75);
    border-radius: 10px;
    transition-duration: 0.3s;
}

.timer-text {
    font-size: 28px;
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.unlock-panel {
    min-width: 480px;
    padding: 40px 48px;
    align-items: center;
}

.unlock-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.unlock-desc {
    font-size: 22px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    margin-bottom: 28px;
    white-space: normal;
}

.unlock-buttons {
    align-items: stretch;
    align-self: stretch;
}

.unlock-buttons > .btn {
    margin: 6px 0;
    font-size: 28px;
    padding: 14px 32px;
}

.hud-bottom {
    flex-direction: row;
    justify-content: center;
    align-self: stretch;
    padding: 12px 16px;
    background-color: rgba(0, 0, 0, 0.5);
}

.hud-bottom > .btn {
    margin: 0 12px;
    font-size: 22px;
    padding: 12px 24px;
}

/* Result overlay panels */
.overlay-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.result-panel {
    min-width: 500px;
    padding: 48px 56px;
}

.result-title {
    font-size: 72px;
    -unity-font-style: bold;
    margin-bottom: 32px;
    -unity-text-align: middle-center;
}

.result-title-cleared {
    color: var(--color-accent);
}

.result-title-failed {
    color: var(--color-danger);
}

.result-buttons {
    align-items: stretch;
    align-self: stretch;
}

.result-buttons > .btn {
    margin: 8px 0;
    font-size: 32px;
    padding: 16px 32px;
}
