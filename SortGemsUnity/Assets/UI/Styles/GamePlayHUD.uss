.hud-top {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    padding: 12px 16px;
    background-color: rgba(0, 0, 0, 0.5);
}

.btn-icon {
    font-size: 20px;
    padding: 8px 12px;
    min-width: 40px;
}

.hud-stage-name {
    font-size: var(--font-size-body);
    color: var(--color-text);
    -unity-font-style: bold;
    margin: 0 12px;
}

.timer-group {
    flex-grow: 1;
    align-items: flex-end;
}

.timer-bar-bg {
    width: 140px;
    height: 10px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 2px;
}

.timer-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(50, 215, 75);
    border-radius: 5px;
    transition-duration: 0.3s;
}

.timer-text {
    font-size: var(--font-size-small);
    color: var(--color-text-dim);
}

.hud-bottom {
    flex-direction: row;
    justify-content: center;
    align-self: stretch;
    padding: 12px 16px;
    background-color: rgba(0, 0, 0, 0.5);
}

.hud-bottom > .btn {
    margin: 0 8px;
}

/* Result overlay panels */
.overlay-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.result-panel {
    min-width: 280px;
    padding: 32px;
}

.result-title {
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.result-title-cleared {
    color: var(--color-accent);
}

.result-title-failed {
    color: var(--color-danger);
}

.result-buttons {
    align-items: stretch;
    align-self: stretch;
}

.result-buttons > .btn {
    margin: 4px 0;
}
