.stage-header {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    padding: 16px 24px;
}

.stage-heading {
    font-size: var(--font-size-heading);
    color: var(--color-text);
    -unity-font-style: bold;
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.btn-small {
    font-size: var(--font-size-small);
    padding: 8px 16px;
}

.carousel-wrapper {
    flex-grow: 1;
    align-self: stretch;
    overflow: visible;
}

.carousel-area {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    flex-grow: 1;
    padding: 0 8px;
}

.carousel-viewport {
    flex-grow: 1;
    overflow: visible;
}

.carousel-content {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    height: 100%;
    transition-property: translate;
    transition-duration: 0ms;
    transition-timing-function: ease-out;
}

.btn-nav {
    font-size: 32px;
    padding: 20px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    min-width: 60px;
    min-height: 60px;
    position: absolute;
    top: 50%;
    margin-top: -30px;
}

.btn-nav-left {
    left: 8px;
}

.btn-nav-right {
    right: 8px;
}

.btn-nav:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.stage-card {
    width: 800px;
    height: 700px;
    background-color: rgba(50, 50, 70, 0.95);
    border-radius: 16px;
    margin: 20px 0;
    margin-left: 16px;
    margin-right: 16px;
    padding: 28px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
}

.stage-card-locked {
    opacity: 0.4;
}

.stage-card-label {
    font-size: 32px;
    color: var(--color-text);
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.stage-card-preview {
    width: 500px;
    height: 500px;
    align-self: center;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(10, 10, 14, 0.4);
    border-radius: 8px;
    margin: 8px 0;
}

.stage-card-active {
    border-width: 3px;
    border-color: var(--color-primary);
    scale: 1.05;
}

.stage-card-status {
    font-size: 24px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    margin-top: 16px;
}

.active-stage-label {
    font-size: 28px;
    color: var(--color-text);
    -unity-text-align: middle-center;
    margin: 16px 0;
}

.btn-start {
    font-size: 36px;
    padding: 18px 72px;
    min-width: 240px;
    margin-top: 16px;
    margin-bottom: 12px;
    align-self: center;
}
