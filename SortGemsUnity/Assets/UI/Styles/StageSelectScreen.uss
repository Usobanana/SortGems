#stage-select-screen {
    background-image: url("project://database/Assets/Textures/bg_stageselect_lofi.png");
    background-size: cover;
    background-position: center;
}

.stage-header {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    padding: var(--sp-md) var(--sp-lg);
    border-radius: 0;
}

.carousel-wrapper {
    align-self: stretch;
    overflow: visible;
    margin-top: var(--sp-lg);
}

.carousel-viewport {
    flex-grow: 1;
    overflow: visible;
}

.carousel-content {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    height: 100%;
    transition-property: translate;
    transition-duration: 0ms;
    transition-timing-function: ease-out;
}

.btn-nav {
    font-size: var(--fs-h3);
    padding: var(--sp-md);
    background-color: rgba(0, 0, 0, 0.65);
    border-radius: var(--radius-round);
    min-width: 64px;
    min-height: 64px;
    position: absolute;
    top: 50%;
    margin-top: -32px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.btn-nav-left {
    left: var(--sp-sm);
}

.btn-nav-right {
    right: var(--sp-sm);
}

.btn-nav:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.stage-card {
    width: 800px;
    height: 700px;
    background-color: var(--color-surface-high);
    border-radius: var(--radius-lg);
    margin: var(--sp-md) 0;
    margin-left: var(--sp-md);
    margin-right: var(--sp-md);
    padding: var(--sp-lg);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
}

.stage-card-locked {
    opacity: 0.4;
}

.stage-card-label {
    font-size: var(--fs-h2);
    color: var(--color-text);
    -unity-font-style: bold;
    margin-bottom: var(--sp-md);
}

.stage-card-preview {
    width: 500px;
    height: 500px;
    align-self: center;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(10, 10, 14, 0.4);
    border-radius: var(--radius-sm);
    margin: var(--sp-sm) 0;
}

.stage-card-active {
    border-width: 3px;
    border-color: var(--color-primary);
    scale: 1.05;
}

.stage-card-status {
    font-size: var(--fs-body);
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    margin-top: var(--sp-md);
}

.active-stage-label {
    width: 800px;
    font-size: var(--fs-h3);
    color: var(--color-text);
    -unity-text-align: middle-center;
    margin: var(--sp-md) 0 0 0;
    padding: var(--sp-sm) var(--sp-lg);
    align-self: center;
}
