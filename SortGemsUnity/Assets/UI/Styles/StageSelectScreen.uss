.stage-header {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    padding: 16px 24px;
}

.stage-heading {
    font-size: var(--font-size-heading);
    color: var(--color-text);
    -unity-font-style: bold;
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.btn-small {
    font-size: var(--font-size-small);
    padding: 8px 16px;
}

.carousel-area {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    flex-grow: 1;
    padding: 0 8px;
}

.carousel-viewport {
    flex-grow: 1;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    min-height: 300px;
}

.carousel-content {
    flex-direction: row;
    align-items: center;
}

.btn-nav {
    font-size: 24px;
    padding: 16px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    min-width: 48px;
    min-height: 48px;
}

.btn-nav:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.stage-card {
    width: 240px;
    height: 280px;
    background-color: var(--color-panel);
    border-radius: var(--border-radius);
    margin: 0 12px;
    padding: 16px;
    align-items: center;
    justify-content: center;
}

.stage-card-locked {
    opacity: 0.4;
}

.stage-card-label {
    font-size: var(--font-size-body);
    color: var(--color-text);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.stage-card-preview {
    flex-grow: 1;
    align-self: stretch;
    align-items: center;
    justify-content: center;
}

.stage-card-active {
    border-width: 3px;
    border-color: var(--color-primary);
    scale: 1.05;
}

.stage-card-status {
    font-size: var(--font-size-small);
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.active-stage-label {
    font-size: var(--font-size-body);
    color: var(--color-text);
    -unity-text-align: middle-center;
    margin: 12px 0;
}

.btn-start {
    font-size: var(--font-size-heading);
    padding: 14px 56px;
    min-width: 180px;
    margin-top: 12px;
    margin-bottom: 8px;
    align-self: center;
}
