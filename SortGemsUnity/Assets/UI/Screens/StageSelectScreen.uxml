<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:sortgems="SortGems.UI">
    <Style src="project://database/Assets/UI/Styles/Common.uss" />
    <Style src="project://database/Assets/UI/Styles/StageSelectScreen.uss" />

    <ui:VisualElement name="stage-select-screen" class="screen">
        <sortgems:EdgeGradientOverlay edge="Top" solid-size="80" fade-size="240" arch-amount="100" tint="#181820" />
        <sortgems:EdgeGradientOverlay edge="Bottom" solid-size="80" fade-size="240" arch-amount="100" tint="#181820" />

        <ui:VisualElement class="stage-header">
            <ui:Button name="btn-back" text="&#x25C0;" class="btn btn-secondary btn-icon" />
        </ui:VisualElement>

        <ui:VisualElement class="carousel-wrapper">
            <ui:VisualElement name="carousel-viewport" class="carousel-viewport">
                <ui:VisualElement name="carousel-content" class="carousel-content" />
            </ui:VisualElement>
            <ui:Button name="btn-prev" text="&#x25C0;" class="btn btn-nav btn-nav-left" />
            <ui:Button name="btn-next" text="&#x25B6;" class="btn btn-nav btn-nav-right" />
        </ui:VisualElement>

        <ui:Label name="active-stage-text" text="" class="active-stage-label scrim text-outline" />

        <ui:Button name="btn-start" text="Start" class="btn btn-lg btn-cta" />

        <ui:VisualElement style="flex-grow: 1;" />
    </ui:VisualElement>
</ui:UXML>
